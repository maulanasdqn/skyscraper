# ── SkyScraper API & Worker ──
DATABASE_URL=postgres://skyscraper:skyscraper@localhost:5432/skyscraper
API_ADMIN_KEY=sk_admin_change_me
PROXY_PASS=change_me
API_LISTEN=0.0.0.0:3002
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=4
CACHE_TTL_SECS=300
DOMAIN_MAX_RPM=30
RUST_LOG=skyscraper=info

# ── Parallax (Proxy Router) ──
PARALLAX_URL=http://localhost:3001
PARALLAX_PROXY_HOST=localhost
PARALLAX_PROXY_PORT=1080
PROXY_USER=
ROUTES=

# ── Cosmium (Anti-fingerprint Browser) ──
COSMIUM_URL=http://localhost:3000
COSMIUM_API_KEY=
COSMIUM_PROFILE=win11_rtx3060_en-us
COSMIUM_LOG=info
PARALLAX_LOG=info
